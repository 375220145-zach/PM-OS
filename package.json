{
  "name": "pm-os",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:demo": "NEXT_PUBLIC_DEMO_MODE=true NEXT_STATIC_EXPORT=true NEXT_PUBLIC_DEEPSEEK_PROXY_URL=https://demo.pm-os.pages.dev/api/ai/chat next build",
    "build:prod": "NEXT_PUBLIC_DEMO_MODE=false NEXT_STATIC_EXPORT=true next build",
    "deploy:pages:demo": "npx wrangler pages deploy out/ --project-name pm-os --branch demo",
    "deploy:pages:prod": "npx wrangler pages deploy out/ --project-name pm-os-prod",
    "deploy:sync-worker": "cd sync-worker && npx wrangler deploy",
    "db:init": "cd sync-worker && npx wrangler d1 execute pm-os-db --remote --file=schema.sql"
  },
  "dependencies": {
    "dexie": "^4.4.3",
    "docx": "^9.7.1",
    "file-saver": "^2.0.5",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "nanoid": "^5.1.11",
    "next": "^16.2.7",
    "openai": "^6.42.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
